{
  "name": "fieldkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite --open /tests/demo.html",
    "start:host": "vite --host --open /tests/demo.html",
    "build": "vite build",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@emotion/styled": "^11.14.1",
    "buffer": "^6.0.3",
    "dompurify": "^3.3.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "use-debounce": "^10.0.6"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.12.4",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitejs/plugin-react": "^5.1.1",
    "esbuild": "^0.27.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.2.0",
    "playwright": "^1.57.0",
    "prettier": "^3.6.2",
    "sass": "^1.94.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.10",
    "whatwg-fetch": "^3.6.20"
  },
  "overrides": {
    "esbuild": "^0.27.0"
  }
